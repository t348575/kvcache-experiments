{
  "model": "meta-llama/Llama-3.2-3B-Instruct",
  "max_model_len": 92000,
  "gpu_mem_util": 0.9,
  "vllm_port": 8000,
  "n_repetitions": 1,
  "server_startup_timeout": 600,
  "output_prefix": "bench_baseline",
  "flush_mode": false,
  "flush": {
    "num_documents": 2,
    "document_length": 90000,
    "max_inflight_requests": 1
  },
  "prefix_cache_script": "prefix_cache_benchmark.py",
  "prefix_cache_defaults": {
    "--num-requests": "48",
    "--doc-size": [
      "1024",
      "10240",
      "40960",
      "81920"
    ],
    "--output-len": [
      "1",
      "256",
      "512",
      "1024"
    ],
    "--prefix-reuse-pct": [
      "0.5",
      "1.0"
    ],
    "--prefix-size": "1.0",
    "--max-concurrency": "8"
  },
  "sharegpt_dataset_path": "dataset/ShareGPT_V3_unfiltered_cleaned_split.json",
  "sharegpt_defaults": {
    "--num-prompts": "100",
    "--request-rate": "32",
    "--percentile-metrics": "ttft,tpot,itl",
    "--metric-percentiles": "95,99",
    "--output-len": 1
  },
  "configs": [
    {
      "name": "baseline",
      "description": "No CPU offloading, no GPU prefix caching",
      "profile_json": "merge.json",
      "vllm_args": {
        "--no-enable-prefix-caching": null
      },
      "prefix_cache_args": {
        "--max-concurrency": [
          "1",
          "2",
          "4",
          "8",
          "16"
        ]
      }
    },
    {
      "name": "baseline_pc",
      "description": "No CPU offloading, GPU prefix caching enabled",
      "profile_json": "merge.json",
      "vllm_args": {},
      "prefix_cache_args": {
        "--max-concurrency": [
          "1",
          "2",
          "4",
          "8",
          "16"
        ]
      }
    }
  ]
}
