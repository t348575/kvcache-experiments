{
  "model": "meta-llama/Llama-3.2-3B-Instruct",
  "max_model_len": 92000,
  "gpu_mem_util": 0.9,
  "vllm_port": 8000,
  "n_repetitions": 1,
  "server_startup_timeout": 600,
  "output_prefix": "bench_py_kvcache",
  "flush_mode": false,
  "flush": {
    "num_documents": 2,
    "document_length": 90000,
    "max_inflight_requests": 1
  },
  "prefix_cache_script": "prefix_cache_benchmark.py",
  "prefix_cache_defaults": {
    "--num-requests": "50",
    "--doc-size": [
      "1024",
      "10240",
      "40960",
      "81920"
    ],
    "--output-len": ["1"],
    "--prefix-reuse-pct": ["0.75"],
    "--prefix-size": "1.0",
    "--max-concurrency": "8"
  },
  "sharegpt_dataset_path": "dataset/ShareGPT_V3_unfiltered_cleaned_split.json",
  "sharegpt_defaults": {
    "--num-prompts": "100",
    "--request-rate": "32",
    "--percentile-metrics": "ttft,tpot,itl",
    "--metric-percentiles": "95,99",
    "--output-len": 1
  },
  "configs": [
    {
      "name": "py_kvcache_no_preload",
      "description": "py_kvcache (SharedStorageOffloadingSpec), preload disabled",
      "profile_json": "merge.json",
      "vllm_args": {
        "--no-enable-prefix-caching": null,
        "--kv-transfer-config": {
          "kv_connector": "OffloadingConnector",
          "kv_role": "kv_both",
          "kv_connector_extra_config": {
            "spec_name": "SharedStorageOffloadingSpec",
            "spec_module_path": "py_kvcache.vllm",
            "shared_storage_path": "{data_dir}/py-kvcache-cache",
            "sync_on_store": false,
            "enable_preload": false,
            "staging_mem": 256,
            "preload_lookahead_requests": 0,
            "preload_share_staging": false,
            "block_size": 256,
            "staging_cache": "off"
          }
        }
      },
      "prefix_cache_args": {
        "--max-concurrency": [
          "8",
          "50"
        ]
      }
    },
    {
      "name": "py_kvcache_preload",
      "description": "py_kvcache (SharedStorageOffloadingSpec), preload enabled (lookahead=16)",
      "profile_json": "merge.json",
      "vllm_args": {
        "--no-enable-prefix-caching": null,
        "--kv-transfer-config": {
          "kv_connector": "OffloadingConnector",
          "kv_role": "kv_both",
          "kv_connector_extra_config": {
            "spec_name": "SharedStorageOffloadingSpec",
            "spec_module_path": "py_kvcache.vllm",
            "shared_storage_path": "{data_dir}/py-kvcache-cache",
            "sync_on_store": false,
            "enable_preload": true,
            "staging_mem": 256,
            "preload_lookahead_requests": 16,
            "preload_share_staging": true,
            "block_size": 256,
            "staging_cache": "off"
          }
        }
      },
      "prefix_cache_args": {
        "--max-concurrency": [
          "8",
          "50"
        ]
      }
    }
  ]
}
